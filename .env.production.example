# ==============================================================================
# DawaiSathi VPS Production Environment Configuration
# Target Domain: dawaisathi.georbit.org
# ==============================================================================

# ── 1. Database Configuration (Self-Hosted on VPS) ───────────────────────────
POSTGRES_USER=dawaisathi
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
POSTGRES_DB=dawaisathi

# ── 2. Security & Admin Keys ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=generate_a_random_32_byte_secret_key_here

# Master superuser key for accessing /admin on dawaisathi.georbit.org
ADMIN_SECRET_KEY=dawaisathi-super-admin-vps-2026-secret

# Comma-separated list of admin emails to auto-promote to superuser upon login
ADMIN_EMAILS=admin@georbit.org

# ── 3. Public Domain & URLs ──────────────────────────────────────────────────
FRONTEND_URL=https://dawaisathi.georbit.org
GOOGLE_REDIRECT_URI=https://dawaisathi.georbit.org/api/auth/callback
TELEGRAM_WEBHOOK_URL=https://dawaisathi.georbit.org

# ── 4. Google OAuth Credentials ──────────────────────────────────────────────
# (From Google Cloud Console -> APIs & Services -> Credentials)
# Authorize JavaScript Origins: https://dawaisathi.georbit.org
# Authorize Redirect URI: https://dawaisathi.georbit.org/api/auth/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── 5. AI Prescription OCR Keys ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ── 6. Cloudinary (Prescription Scan Storage) ─────────────────────────────────
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# ── 7. Telegram Bot Notifications ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── 8. Web Push Notifications (VAPID) ────────────────────────────────────────
# Generate once with: python backend/generate_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@georbit.org

# ── 9. Cron / Adherence Scheduler ────────────────────────────────────────────
CRON_SECRET=generate_a_random_cron_secret_here
